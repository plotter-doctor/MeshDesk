#!/usr/bin/python3 -IB
"""Use private application libraries with the distribution's Python and Qt."""
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'share/meshdesk/python'))
os.environ.setdefault('QT_QUICK_BACKEND', 'software')
os.environ.setdefault('QT_QUICK_CONTROLS_STYLE', 'Material')
if Path(sys.argv[0]).name == 'meshdesk-simulator':
    from meshdesk.simulator import main
else:
    from meshdesk.app import main
sys.exit(main())
